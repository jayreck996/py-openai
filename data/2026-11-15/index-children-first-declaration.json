min-h-0 overflow-hidden\"><div class=\"relative min-h-0 w-full\" style=\"aspect-ratio:1/1\"><div class=\"size-full\"><div class=\"group relative overflow-hidden rounded-none image-aspect-center aspect-(--image-aspect-ratio) max-h-full max-w-full bg-transparent transition-[background] duration-medium ease-curve-d\" style=\"--image-aspect-ratio:1/1\"><img alt=\"OpenAI appoints Dan Driscoll as Senior Counselor for National Security Modernization — Cover\" class=\"object-cover object-center\" data-nimg=\"fill\" data-nosnippet=\"true\" decoding=\"async\" loading=\"lazy\" sizes=\"(min-width: 1728px) 1728px, 100vw\" src=\"https://images.ctfassets.net/kftzwdyauwt9/MWZNeudWSxYE1AOyORvmG/e5efa65f5cba9117c53a77ab1be52d82/dan-driscoll-joins-openai-cover.png?w=3840&amp;q=90&amp;fm=webp\" srcset=\"https://images.ctfassets.net/kftzwdyauwt9/MWZNeudWSxYE1AOyORvmG/e5efa65f5cba9117c53a77ab1be52d82/dan-driscoll-joins-openai-cover.png?w=640&amp;q=90&amp;fm=webp 640w, https://images.ctfassets.net/kftzwdyauwt9/MWZNeudWSxYE1AOyORvmG/e5efa65f5cba9117c53a77ab1be52d82/dan-driscoll-joins-openai-cover.png?w=750&amp;q=90&amp;fm=webp 750w, https://images.ctfassets.net/kftzwdyauwt9/MWZNeudWSxYE1AOyORvmG/e5efa65f5cba9117c53a77ab1be52d82/dan-driscoll-joins-openai-cover.png?w=828&amp;q=90&amp;fm=webp 828w, https://images.ctfassets.net/kftzwdyauwt9/MWZNeudWSxYE1AOyORvmG/e5efa65f5cba9117c53a77ab1be52d82/dan-driscoll-joins-openai-cover.png?w=1080&amp;q=90&amp;fm=webp 1080w, https://images.ctfassets.net/kftzwdyauwt9/MWZNeudWSxYE1AOyORvmG/e5efa65f5cba9117c53a77ab1be52d82/dan-driscoll-joins-openai-cover.png?w=1200&amp;q=90&amp;fm=webp 1200w, https://images.ctfassets.net/kftzwdyauwt9/MWZNeudWSxYE1AOyORvmG/e5efa65f5cba9117c53a77ab1be52d82/dan-driscoll-joins-openai-cover.png?w=1920&amp;q=90&amp;fm=webp 1920w, https://images.ctfassets.net/kftzwdyauwt9/MWZNeudWSxYE1AOyORvmG/e5efa65f5cba9117c53a77ab1be52d82/dan-driscoll-joins-openai-cover.png?w=2048&amp;q=90&amp;fm=webp 2048w, https://images.ctfassets.net/kftzwd